# ---------------------------------------------------------------------------
# Medic-stock (MSS) — production variables
#
#   cp deploy/.env.example deploy/.env
#   nano deploy/.env
#   chmod 600 deploy/.env
#
# deploy/.env holds every password of the system. It must never go into git.
# ---------------------------------------------------------------------------

# Address of the system, with https. It is the base of the links sent by e-mail
# (first access and password recovery), so a wrong value here produces invitations
# that lead nowhere.
FRONTEND_URL=https://estoque.seudominio.com.br

# Name printed on the reports and shown on the login page when there is no logo.
COMPANY_NAME=Baumer

# --- Secrets -------------------------------------------------------------
# Generate each one with:  openssl rand -base64 36
# Do not reuse the same value in more than one line.

# Signs the session cookies. Changing it later logs everybody out — which is
# exactly what you want if you ever suspect it leaked.
JWT_SECRET=

MSS_DB_PASSWORD=
MAIL_DB_PASSWORD=
RABBITMQ_PASSWORD=

# --- SMTP ----------------------------------------------------------------
# Without this the mail service does not start. The system keeps working for
# everyone who already has a password; what stops is the invitation of new users
# and password recovery.
#
# Gmail: host smtp.gmail.com, port 587, MAIL_USERNAME is the full address and
# MAIL_PASSWORD is an app password (Google account > Security > 2-step
# verification > App passwords) — the account password does not work.
# Zoho: smtp.zoho.com, 587.  Brevo: smtp-relay.brevo.com, 587.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Names (defaults are fine) -------------------------------------------
MSS_DB_NAME=mssdb
MSS_DB_USER=mss
MAIL_DB_NAME=mssemaildb
MAIL_DB_USER=email
RABBITMQ_USER=mss
